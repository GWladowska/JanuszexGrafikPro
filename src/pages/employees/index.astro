---
import Layout from "@/layouts/Layout.astro";
import DbErrorState from "@/components/business/DbErrorState.astro";
import EmployeeManager from "@/components/employees/EmployeeManager";
import { createClient } from "@/lib/supabase";
import { getBusinessForOwner } from "@/lib/services/business";
import { getEmployees } from "@/lib/services/employee";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return Astro.redirect("/auth/signin");
}

const businessResult = await getBusinessForOwner(supabase, user.id);
if (businessResult.error === null && businessResult.data === null) {
  return Astro.redirect("/business/setup");
}
const business = businessResult.error === null ? businessResult.data : null;
const dbError = businessResult.error;

const employeesResult = business !== null ? await getEmployees(supabase, business.id) : null;
const employeesFailed = employeesResult !== null && employeesResult.error !== null;
const employees = employeesResult !== null && employeesResult.error === null ? employeesResult.data : [];
---

<Layout title={dbError !== null ? "Coś poszło nie tak" : "Pracownicy"}>
  {
    dbError !== null ? (
      <DbErrorState />
    ) : (
      <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-xl space-y-6">
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
            <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
              Pracownicy
            </h1>
            {employeesFailed ? (
              <p class="rounded-lg border border-red-400/30 bg-red-500/10 px-3 py-2 text-sm text-red-100">
                Nie udało się pobrać listy pracowników. Odśwież stronę, aby spróbować ponownie.
              </p>
            ) : (
              <EmployeeManager initialEmployees={employees} client:load />
            )}
          </div>

          <p class="text-center">
            <a href="/dashboard" class="text-sm text-purple-300 hover:underline">
              Wróć do dashboardu
            </a>
          </p>
        </div>
      </div>
    )
  }
</Layout>
